{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory_session_start.py\"",
            "timeout": 20,
            "statusMessage": "Loading Memory MCP context…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory_stop_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
