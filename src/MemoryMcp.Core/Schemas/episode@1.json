{
  "$id": "episode@1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary"],
  "unevaluatedProperties": false,
  "x-retrieval": { "version": "r1", "class": "episodic", "halfLifeDays": 7, "expectsTags": true, "expectsLinks": false, "claimLike": false },
  "properties": {
    "summary": {
      "type": "string",
      "description": "What happened, e.g. 'sent the easement letter to the neighbour'.",
      "x-retrieval": { "lexical": "primary", "semantic": "summary" }
    },
    "occurred_utc": {
      "type": "string",
      "description": "When it happened (ISO-8601).",
      "x-retrieval": { "lexical": "none", "semantic": false, "role": "observed_at" }
    },
    "participants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Who/what was involved.",
      "x-retrieval": { "lexical": "primary", "semantic": "summary" }
    },
    "outcome": {
      "type": "string",
      "description": "Result or follow-up, if any.",
      "x-retrieval": { "lexical": "primary", "semantic": "summary" }
    }
  }
}
