{
  "$id": "backlog_item@1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["key", "status"],
  "additionalProperties": false,
  "x-retrieval": { "version": "r1", "class": "workflow", "halfLifeDays": 45, "expectsTags": true, "expectsLinks": true, "claimLike": false },
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$",
      "x-retrieval": { "lexical": "primary", "semantic": false }
    },
    "project": {
      "type": "string",
      "description": "Project slug this ticket belongs to, e.g. memory-mcp. Mirrors the key prefix; lets one query a project's backlog across domains.",
      "x-retrieval": { "lexical": "secondary", "semantic": false }
    },
    "status": {
      "enum": ["ready", "next", "later", "in_progress", "done", "blocked"],
      "x-retrieval": { "lexical": "none", "semantic": false }
    },
    "sprint": {
      "type": "string",
      "description": "Sprint key this ticket belongs to (e.g. S1); unset = general backlog, not in any sprint.",
      "x-retrieval": { "lexical": "secondary", "semantic": false }
    },
    "assignee": {
      "type": "string",
      "description": "Who should act on this, e.g. 'me', 'agent', or a name. Personal-backlog views filter on it (hide agent-owned tasks).",
      "x-retrieval": { "lexical": "secondary", "semantic": false }
    },
    "priority": {
      "enum": ["low", "normal", "high"],
      "x-retrieval": { "lexical": "none", "semantic": false }
    },
    "acceptance": {
      "type": "string",
      "x-retrieval": { "lexical": "primary", "semantic": "acceptance" }
    },
    "estimate": {
      "type": "string",
      "x-retrieval": { "lexical": "none", "semantic": false }
    },
    "blocked_by": {
      "type": "array",
      "items": { "type": "string" },
      "x-retrieval": { "lexical": "secondary", "semantic": false }
    }
  }
}
